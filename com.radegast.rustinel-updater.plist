<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.radegast.rustinel-updater</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/radegast/rustinel-updater</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/radegast/rustinel-updater.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/radegast/rustinel-updater.err</string>
    <key>UserName</key>
    <string>root</string>
</dict>
</plist>
